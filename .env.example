# PCC PMS 2026 — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Database (PostgreSQL via Postgres.app) ───
# After installing Postgres.app, create DB:
#   psql -c "CREATE DATABASE pcc_pms_dev;"
#   psql -c "CREATE USER pcc_user WITH PASSWORD 'pcc_dev_pass';"
#   psql -c "GRANT ALL PRIVILEGES ON DATABASE pcc_pms_dev TO pcc_user;"
DATABASE_URL="postgresql://pcc_user:pcc_dev_pass@localhost:5432/pcc_pms_dev"

# ─── NextAuth.js ───
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
AUTH_URL="http://localhost:3000"

# ─── App Config ───
NEXT_PUBLIC_APP_NAME="PCC PMS 2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── File Upload ───
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=8

# ─── (Future) Linux Production ───
# DATABASE_URL="postgresql://pcc_user:STRONG_PASS@localhost:5432/pcc_pms_prod"
# AUTH_URL="https://your-domain.com"
