// PCC PMS 2026 — Prisma Schema
// Database: PostgreSQL 16
// Generated: Phase 0 Setup

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  projectMembers ProjectMember[]
  auditLogs      AuditLog[]
  workflowRecords WorkflowRecord[]
  evidenceFiles  EvidenceFile[]
  dailyLogs      DailyLog[]

  @@map("users")
}

enum UserRole {
  SYSTEM_ADMIN   // R01 ผู้ดูแลระบบ
  EXECUTIVE      // R02 ผู้บริหาร
  PM             // R03 ผู้จัดการโครงการ
  ENGINEER       // R04 วิศวกรโครงการ
  SITE_ENGINEER  // R05 วิศวกรหน้างาน
  QC_INSPECTOR   // R06 QC
  WAREHOUSE      // R07 คลัง/จัดซื้อ
  TRANSPORT      // R08 ขนส่ง
  OWNER          // เจ้าของโครงการ (ลูกค้า)
  STAFF          // พนักงานทั่วไป
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  code        String        @unique // e.g. PCC-26001
  name        String
  workType    WorkType      @map("work_type")
  status      ProjectStatus @default(DRAFT)
  clientName  String        @map("client_name")
  contractNo  String?       @map("contract_no")
  siteAddress String?       @map("site_address")
  startDate   DateTime?     @map("start_date")
  targetDate  DateTime?     @map("target_date")
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members        ProjectMember[]
  workPackages   WorkPackage[]
  contracts      Contract[]
  tasks          Task[]
  workflowRecords WorkflowRecord[]
  evidenceFiles  EvidenceFile[]
  materialRequests MaterialRequest[]
  dailyLogs      DailyLog[]
  auditLogs      AuditLog[]
  publications   Publication[]

  @@map("projects")
}

enum WorkType {
  F    // งานเสารั้ว (Fence)
  RW   // งานกำแพงกันดิน (Retaining Wall)
  RWF  // งานกำแพงกันดิน + เสารั้ว
  PT   // งานพื้นโพสเทนชั่น (Post-Tension)
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  roleInProject ProjectMemberRole @map("role_in_project")
  assignedAt DateTime   @default(now()) @map("assigned_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
}

enum ProjectMemberRole {
  PM
  ENGINEER
  SITE_ENGINEER
  QC_INSPECTOR
  WAREHOUSE
  TRANSPORT
  COST_CONTROLLER
  OBSERVER
}

// ─────────────────────────────────────────────
// WORK PACKAGES & TASKS
// ─────────────────────────────────────────────

model WorkPackage {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  code        String   // e.g. WP-F-01
  name        String
  zone        String?  // Zone A, B, C
  target      Decimal  @db.Decimal(14, 3)   // target quantity
  unit        String   @default("ต้น")
  weight      Decimal  @db.Decimal(8, 3)    // % weight for progress
  status      WorkPackageStatus @default(PENDING)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks           Task[]
  workflowRecords WorkflowRecord[]
  materialRequests MaterialRequest[]

  @@map("work_packages")
}

enum WorkPackageStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model Task {
  id          String     @id @default(cuid())
  projectId   String     @map("project_id")
  packageId   String     @map("package_id")
  code        String     // e.g. F-S01, PT-AP1
  name        String
  stepIndex   Int        @map("step_index")
  status      TaskStatus @default(PENDING)
  plannedStart DateTime? @map("planned_start")
  plannedEnd   DateTime? @map("planned_end")
  actualStart  DateTime? @map("actual_start")
  actualEnd    DateTime? @map("actual_end")
  dependsOn   String[]   @map("depends_on") // array of task codes
  isGate      Boolean    @default(false) @map("is_gate")
  gateCode    String?    @map("gate_code") // AP1, AP2, QC-01, etc.
  notes       String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id])
  workPackage WorkPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dailyLogs   DailyLog[]

  @@map("tasks")
}

enum TaskStatus {
  PENDING
  BLOCKED
  IN_PROGRESS
  DONE
  QC_PASSED
  SKIPPED
}

// ─────────────────────────────────────────────
// WORKFLOW RECORDS (Approvals, QC, NCR etc.)
// ─────────────────────────────────────────────

model WorkflowRecord {
  id          String         @id @default(cuid())
  projectId   String         @map("project_id")
  packageId   String?        @map("package_id")
  kind        WorkflowKind
  status      RecordStatus   @default(DRAFT)
  createdById String         @map("created_by_id")
  reviewedById String?       @map("reviewed_by_id")
  data        Json           @default("{}")
  notes       String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id])
  workPackage WorkPackage? @relation(fields: [packageId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])
  evidenceFiles EvidenceFile[]
  ncrRecords  NcrRecord[]

  @@index([projectId, kind, status])
  @@map("workflow_records")
}

enum WorkflowKind {
  DAILY_LOG       // บันทึกผลงานประจำวัน
  QC_REQUEST      // คำขอตรวจ QC
  QC_RESULT       // ผลตรวจ QC
  APPROVAL_GATE   // จุดอนุมัติ (AP1-AP7, Gate QC)
  MATERIAL_REQUEST // คำขอวัสดุ
  TRANSPORT_TRIP  // เที่ยวขนส่ง
  RECEIVING       // ตรวจรับหน้างาน
  PUBLICATION     // เผยแพร่ให้ Owner
  HANDOVER        // ส่งมอบ
}

enum RecordStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

// ─────────────────────────────────────────────
// NCR (Non-Conformance Report)
// ─────────────────────────────────────────────

model NcrRecord {
  id          String    @id @default(cuid())
  recordId    String    @map("record_id") // linked to QC_RESULT record
  code        String    @unique // NCR-2026-001
  description String    @db.Text
  severity    NcrSeverity @default(MAJOR)
  assignedTo  String?   @map("assigned_to")
  dueDate     DateTime? @map("due_date")
  closedAt    DateTime? @map("closed_at")
  status      NcrStatus @default(OPEN)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  record WorkflowRecord @relation(fields: [recordId], references: [id])

  @@map("ncr_records")
}

enum NcrSeverity {
  CRITICAL
  MAJOR
  MINOR
  OBSERVATION
}

enum NcrStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  CLOSED
}

// ─────────────────────────────────────────────
// DAILY LOG
// ─────────────────────────────────────────────

model DailyLog {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  taskId      String   @map("task_id")
  logDate     DateTime @map("log_date") @db.Date
  quantity    Decimal? @db.Decimal(14, 3)
  unit        String?
  description String?  @db.Text
  issues      String?  @db.Text
  workers     Int?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id])
  task        Task     @relation(fields: [taskId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
  evidenceFiles EvidenceFile[]

  @@map("daily_logs")
}

// ─────────────────────────────────────────────
// EVIDENCE FILES
// ─────────────────────────────────────────────

model EvidenceFile {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  recordId    String?  @map("record_id")
  dailyLogId  String?  @map("daily_log_id")
  createdById String   @map("created_by_id")
  filename    String
  storagePath String   @map("storage_path")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  project  Project         @relation(fields: [projectId], references: [id])
  record   WorkflowRecord? @relation(fields: [recordId], references: [id])
  dailyLog DailyLog?       @relation(fields: [dailyLogId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@map("evidence_files")
}

// ─────────────────────────────────────────────
// MATERIALS
// ─────────────────────────────────────────────

model MaterialRequest {
  id          String        @id @default(cuid())
  projectId   String        @map("project_id")
  packageId   String        @map("package_id")
  requestNo   String        @unique @map("request_no")
  status      RecordStatus  @default(DRAFT)
  drawingRev  String?       @map("drawing_rev")
  neededBy    DateTime?     @map("needed_by")
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id])
  workPackage WorkPackage @relation(fields: [packageId], references: [id])
  items       MaterialRequestItem[]
  trips       TransportTrip[]

  @@map("material_requests")
}

model MaterialRequestItem {
  id          String  @id @default(cuid())
  requestId   String  @map("request_id")
  itemCode    String  @map("item_code")
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit        String
  confirmed   Decimal? @db.Decimal(14, 3)
  shortage    Decimal? @db.Decimal(14, 3)

  request MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("material_request_items")
}

// ─────────────────────────────────────────────
// TRANSPORT
// ─────────────────────────────────────────────

model TransportTrip {
  id          String      @id @default(cuid())
  requestId   String      @map("request_id")
  tripNo      String      @unique @map("trip_no")
  driverName  String?     @map("driver_name")
  plateNo     String?     @map("plate_no")
  status      TripStatus  @default(SCHEDULED)
  scheduledAt DateTime?   @map("scheduled_at")
  departedAt  DateTime?   @map("departed_at")
  arrivedAt   DateTime?   @map("arrived_at")
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  request   MaterialRequest @relation(fields: [requestId], references: [id])
  receiving ReceivingRecord?

  @@map("transport_trips")
}

enum TripStatus {
  SCHEDULED
  LOADING
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

model ReceivingRecord {
  id          String   @id @default(cuid())
  tripId      String   @unique @map("trip_id")
  receivedAt  DateTime @map("received_at")
  goodQty     Decimal  @db.Decimal(14, 3) @map("good_qty")
  badQty      Decimal  @db.Decimal(14, 3) @map("bad_qty")
  missingQty  Decimal  @db.Decimal(14, 3) @map("missing_qty")
  receivedBy  String   @map("received_by")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  trip TransportTrip @relation(fields: [tripId], references: [id])

  @@map("receiving_records")
}

// ─────────────────────────────────────────────
// CONTRACTS & FINANCE
// ─────────────────────────────────────────────

model Contract {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  contractNo    String   @unique @map("contract_no")
  revision      Int      @default(1)
  baseValue     Decimal  @db.Decimal(16, 2) @map("base_value")
  variationTotal Decimal @default(0) @db.Decimal(16, 2) @map("variation_total")
  currency      String   @default("THB")
  signedDate    DateTime? @map("signed_date")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project        Project          @relation(fields: [projectId], references: [id])
  billingPeriods BillingPeriod[]

  @@map("contracts")
}

model BillingPeriod {
  id          String        @id @default(cuid())
  contractId  String        @map("contract_id")
  periodNo    Int           @map("period_no")
  status      BillingStatus @default(DRAFT)
  baseAmount  Decimal       @db.Decimal(16, 2) @map("base_amount")
  adjustments Decimal       @default(0) @db.Decimal(16, 2)
  retention   Decimal       @default(0) @db.Decimal(16, 2)
  advance     Decimal       @default(0) @db.Decimal(16, 2)
  netAmount   Decimal       @db.Decimal(16, 2) @map("net_amount")
  dueDate     DateTime?     @map("due_date")
  submittedAt DateTime?     @map("submitted_at")
  approvedAt  DateTime?     @map("approved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  contract Contract  @relation(fields: [contractId], references: [id])
  payments Payment[]

  @@map("billing_periods")
}

enum BillingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  INVOICED
  PARTIALLY_PAID
  PAID
  DISPUTED
}

model Payment {
  id          String   @id @default(cuid())
  periodId    String   @map("period_id")
  amount      Decimal  @db.Decimal(16, 2)
  paidAt      DateTime @map("paid_at")
  reference   String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  period BillingPeriod @relation(fields: [periodId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────
// PUBLICATIONS (Owner Portal)
// ─────────────────────────────────────────────

model Publication {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  title       String
  snapshot    Json     @default("{}")
  publishedAt DateTime @default(now()) @map("published_at")
  publishedBy String   @map("published_by")

  project Project @relation(fields: [projectId], references: [id])

  @@map("publications")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  action    String
  entityId  String?  @map("entity_id")
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_logs")
}
