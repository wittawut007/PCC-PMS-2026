generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?          @map("password_hash")
  role            UserRole         @default(STAFF)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  accounts        Account[]
  auditLogs       AuditLog[]
  dailyLogs       DailyLog[]
  evidenceFiles   EvidenceFile[]
  projectMembers  ProjectMember[]
  sessions        Session[]
  workflowRecords WorkflowRecord[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  workType         WorkType          @map("work_type")
  status           ProjectStatus     @default(DRAFT)
  clientName       String            @map("client_name")
  contractNo       String?           @map("contract_no")
  siteAddress      String?           @map("site_address")
  startDate        DateTime?         @map("start_date")
  targetDate       DateTime?         @map("target_date")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  auditLogs        AuditLog[]
  contracts        Contract[]
  dailyLogs        DailyLog[]
  evidenceFiles    EvidenceFile[]
  drawings         Drawing[]
  materialRequests MaterialRequest[]
  members          ProjectMember[]
  productionOrders ProductionOrder[]
  publications     Publication[]
  qcInspections    QcInspection[]
  approvalGates    ApprovalGate[]
  ncrRecords       NcrRecord[]
  tasks            Task[]
  transportTrips   TransportTrip[]
  workPackages     WorkPackage[]
  workflowRecords  WorkflowRecord[]

  @@map("projects")
}

model ProjectMember {
  id            String            @id @default(cuid())
  projectId     String            @map("project_id")
  userId        String            @map("user_id")
  roleInProject ProjectMemberRole @map("role_in_project")
  assignedAt    DateTime          @default(now()) @map("assigned_at")
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
}

model WorkPackage {
  id               String            @id @default(cuid())
  projectId        String            @map("project_id")
  code             String
  name             String
  zone             String?
  target           Decimal           @db.Decimal(14, 3)
  unit             String            @default("ต้น")
  weight           Decimal           @db.Decimal(8, 3)
  status           WorkPackageStatus @default(PENDING)
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  drawings         Drawing[]
  materialRequests MaterialRequest[]
  tasks            Task[]
  transportTrips   TransportTrip[]
  qcInspections    QcInspection[]
  approvalGates    ApprovalGate[]
  dailyLogs        DailyLog[]
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRecords  WorkflowRecord[]

  @@map("work_packages")
}

model Task {
  id           String      @id @default(cuid())
  projectId    String      @map("project_id")
  packageId    String      @map("package_id")
  code         String
  name         String
  stepIndex    Int         @map("step_index")
  status       TaskStatus  @default(PENDING)
  plannedStart DateTime?   @map("planned_start")
  plannedEnd   DateTime?   @map("planned_end")
  actualStart  DateTime?   @map("actual_start")
  actualEnd    DateTime?   @map("actual_end")
  dependsOn    String[]    @map("depends_on")
  isGate       Boolean     @default(false) @map("is_gate")
  gateCode     String?     @map("gate_code")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  dailyLogs    DailyLog[]
  workPackage  WorkPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  project      Project     @relation(fields: [projectId], references: [id])

  @@map("tasks")
}

model WorkflowRecord {
  id            String         @id @default(cuid())
  projectId     String         @map("project_id")
  packageId     String?        @map("package_id")
  kind          WorkflowKind
  status        RecordStatus   @default(DRAFT)
  createdById   String         @map("created_by_id")
  reviewedById  String?        @map("reviewed_by_id")
  data          Json           @default("{}")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  evidenceFiles EvidenceFile[]
  ncrRecords    NcrRecord[]
  createdBy     User           @relation(fields: [createdById], references: [id])
  workPackage   WorkPackage?   @relation(fields: [packageId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])

  @@index([projectId, kind, status])
  @@map("workflow_records")
}

model NcrRecord {
  id                String         @id @default(cuid())
  recordId          String?        @map("record_id")
  projectId         String?        @map("project_id")
  code              String         @unique
  description       String
  severity          NcrSeverity    @default(MAJOR)
  assignedTo        String?        @map("assigned_to")
  dueDate           DateTime?      @map("due_date")
  closedAt          DateTime?      @map("closed_at")
  status            NcrStatus      @default(OPEN)
  location          String?
  referenceDoc      String?        @map("reference_doc")
  correctiveAction  String?        @map("corrective_action")
  verificationNotes String?        @map("verification_notes")
  history           Json           @default("[]")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  record            WorkflowRecord? @relation(fields: [recordId], references: [id])
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ncr_records")
}

model DailyLog {
  id            String         @id @default(cuid())
  projectId     String         @map("project_id")
  packageId     String?        @map("package_id")
  taskId        String?        @map("task_id")
  logDate       DateTime       @map("log_date") @db.Date
  location      String?
  activity      String?
  quantity      Decimal?       @db.Decimal(14, 3)
  unit          String?
  description   String?
  issues        String?
  workers       Int?
  workHours     Decimal?       @map("work_hours") @db.Decimal(5, 2)
  equipment     String?
  status        String         @default("DRAFT")
  qcStatus      String         @default("NOT_VERIFIED") @map("qc_status")
  photos        Json           @default("[]")
  createdById   String?        @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  createdBy     User?          @relation(fields: [createdById], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage   WorkPackage?   @relation(fields: [packageId], references: [id])
  task          Task?          @relation(fields: [taskId], references: [id])
  evidenceFiles EvidenceFile[]

  @@map("daily_logs")
}

model QcInspection {
  id           String       @id @default(cuid())
  inspectionNo String       @unique @map("inspection_no")
  projectId    String       @map("project_id")
  packageId    String?      @map("package_id")
  scope        String?
  drawingRef   String?      @map("drawing_ref")
  status       String       @default("RE_INSPECT")
  inspector    String?      @default("QC โครงการ")
  inspectedAt  DateTime?    @map("inspected_at")
  checklist    Json         @default("[]")
  notes        String?
  photos       Json         @default("[]")
  ncrCode      String?      @map("ncr_code")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage  WorkPackage? @relation(fields: [packageId], references: [id])

  @@map("qc_inspections")
}

model ApprovalGate {
  id             String       @id @default(cuid())
  projectId      String       @map("project_id")
  packageId      String?      @map("package_id")
  gateCode       String       @map("gate_code")
  title          String
  unlockedAction String       @map("unlocked_action")
  status         String       @default("WAITING")
  pourZone       String?      @map("pour_zone")
  testResult     String?      @map("test_result")
  standardRef    String?      @map("standard_ref")
  approver       String?
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage    WorkPackage? @relation(fields: [packageId], references: [id])

  @@unique([projectId, gateCode])
  @@map("approval_gates")
}

model EvidenceFile {
  id          String          @id @default(cuid())
  projectId   String          @map("project_id")
  recordId    String?         @map("record_id")
  dailyLogId  String?         @map("daily_log_id")
  createdById String          @map("created_by_id")
  filename    String
  storagePath String          @map("storage_path")
  mimeType    String          @map("mime_type")
  sizeBytes   Int             @map("size_bytes")
  createdAt   DateTime        @default(now()) @map("created_at")
  createdBy   User            @relation(fields: [createdById], references: [id])
  dailyLog    DailyLog?       @relation(fields: [dailyLogId], references: [id])
  project     Project         @relation(fields: [projectId], references: [id])
  record      WorkflowRecord? @relation(fields: [recordId], references: [id])

  @@map("evidence_files")
}

model MaterialRequest {
  id               String                @id @default(cuid())
  projectId        String                @map("project_id")
  packageId        String                @map("package_id")
  drawingId        String?               @map("drawing_id")
  requestNo        String                @unique @map("request_no")
  status           RecordStatus          @default(DRAFT)
  drawingRev       String?               @map("drawing_rev")
  neededBy         DateTime?             @map("needed_by")
  notes            String?

  // ข้อมูลตอบกลับจากคลัง (Warehouse Response)
  externalRef      String?               @map("external_ref")
  warehouseName    String?               @map("warehouse_name")
  storageLocation  String?               @map("storage_location")
  confirmedBy      String?               @map("confirmed_by")
  confirmedAt      DateTime?             @map("confirmed_at")
  responseFileUrl  String?               @map("response_file_url")
  warehouseNotes   String?               @map("warehouse_notes")

  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  items            MaterialRequestItem[]
  workPackage      WorkPackage           @relation(fields: [packageId], references: [id])
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawing          Drawing?              @relation(fields: [drawingId], references: [id])
  productionOrders ProductionOrder[]
  trips            TransportTrip[]

  @@map("material_requests")
}

model MaterialRequestItem {
  id          String          @id @default(cuid())
  requestId   String          @map("request_id")
  bomItemId   String?         @map("bom_item_id")
  itemCode    String          @map("item_code")
  description String
  quantity    Decimal         @db.Decimal(14, 3)
  unit        String
  allocated   Decimal         @default(0) @db.Decimal(14, 3)
  confirmed   Decimal?        @db.Decimal(14, 3)
  shortage    Decimal?        @db.Decimal(14, 3)
  notes       String?

  request     MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bomItem     BomItem?        @relation(fields: [bomItemId], references: [id])

  @@map("material_request_items")
}

model TransportTrip {
  id               String           @id @default(cuid())
  projectId        String?          @map("project_id")
  packageId        String?          @map("package_id")
  requestId        String?          @map("request_id")
  tripNo           String           @unique @map("trip_no")
  driverName       String?          @map("driver_name")
  driverPhone      String?          @map("driver_phone")
  plateNo          String?          @map("plate_no")
  origin           String?          @default("คลังภายนอก")
  destination      String?          @default("โซน A")
  deliveryNoteNo   String?          @map("delivery_note_no")
  cargoDescription String?          @map("cargo_description")
  cargoQty         Decimal?         @map("cargo_qty") @db.Decimal(14, 3)
  unit             String?          @default("แผ่น")
  status           TripStatus       @default(SCHEDULED)
  scheduledAt      DateTime?        @map("scheduled_at")
  departedAt       DateTime?        @map("departed_at")
  arrivedAt        DateTime?        @map("arrived_at")
  deliveredAt      DateTime?        @map("delivered_at")
  timeline         Json             @default("[]")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  receiving        ReceivingRecord?
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage      WorkPackage?     @relation(fields: [packageId], references: [id])
  request          MaterialRequest? @relation(fields: [requestId], references: [id])

  @@map("transport_trips")
}

model ReceivingRecord {
  id             String        @id @default(cuid())
  tripId         String        @unique @map("trip_id")
  receivedAt     DateTime      @map("received_at")
  receivedBy     String        @map("received_by")
  deliveredQty   Decimal       @default(0) @map("delivered_qty") @db.Decimal(14, 3)
  actualQty      Decimal       @default(0) @map("actual_qty") @db.Decimal(14, 3)
  goodQty        Decimal       @map("good_qty") @db.Decimal(14, 3)
  badQty         Decimal       @map("bad_qty") @db.Decimal(14, 3)
  missingQty     Decimal       @map("missing_qty") @db.Decimal(14, 3)
  damageNotes    String?       @map("damage_notes")
  attachedFiles  Json          @default("[]") @map("attached_files")
  status         String        @default("PARTIAL")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  trip           TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("receiving_records")
}

model Contract {
  id             String          @id @default(cuid())
  projectId      String          @map("project_id")
  contractNo     String          @unique @map("contract_no")
  revision       Int             @default(1)
  baseValue      Decimal         @map("base_value") @db.Decimal(16, 2)
  variationTotal Decimal         @default(0) @map("variation_total") @db.Decimal(16, 2)
  currency       String          @default("THB")
  signedDate     DateTime?       @map("signed_date")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  billingPeriods BillingPeriod[]
  project        Project         @relation(fields: [projectId], references: [id])

  @@map("contracts")
}

model BillingPeriod {
  id          String        @id @default(cuid())
  contractId  String        @map("contract_id")
  periodNo    Int           @map("period_no")
  status      BillingStatus @default(DRAFT)
  baseAmount  Decimal       @map("base_amount") @db.Decimal(16, 2)
  adjustments Decimal       @default(0) @db.Decimal(16, 2)
  retention   Decimal       @default(0) @db.Decimal(16, 2)
  advance     Decimal       @default(0) @db.Decimal(16, 2)
  netAmount   Decimal       @map("net_amount") @db.Decimal(16, 2)
  dueDate     DateTime?     @map("due_date")
  submittedAt DateTime?     @map("submitted_at")
  approvedAt  DateTime?     @map("approved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  contract    Contract      @relation(fields: [contractId], references: [id])
  payments    Payment[]

  @@map("billing_periods")
}

model Payment {
  id        String        @id @default(cuid())
  periodId  String        @map("period_id")
  amount    Decimal       @db.Decimal(16, 2)
  paidAt    DateTime      @map("paid_at")
  reference String?
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  period    BillingPeriod @relation(fields: [periodId], references: [id])

  @@map("payments")
}

model Publication {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  title       String
  snapshot    Json     @default("{}")
  publishedAt DateTime @default(now()) @map("published_at")
  publishedBy String   @map("published_by")
  project     Project  @relation(fields: [projectId], references: [id])

  @@map("publications")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  action    String
  entityId  String?  @map("entity_id")
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project? @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_logs")
}

enum UserRole {
  SYSTEM_ADMIN
  EXECUTIVE
  PM
  ENGINEER
  SITE_ENGINEER
  QC_INSPECTOR
  WAREHOUSE
  TRANSPORT
  OWNER
  STAFF
}

enum WorkType {
  F
  RW
  RWF
  PT
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum ProjectMemberRole {
  PM
  ENGINEER
  SITE_ENGINEER
  QC_INSPECTOR
  WAREHOUSE
  TRANSPORT
  COST_CONTROLLER
  OBSERVER
}

enum WorkPackageStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  PENDING
  BLOCKED
  IN_PROGRESS
  DONE
  QC_PASSED
  SKIPPED
}

enum WorkflowKind {
  DAILY_LOG
  QC_REQUEST
  QC_RESULT
  APPROVAL_GATE
  MATERIAL_REQUEST
  TRANSPORT_TRIP
  RECEIVING
  PUBLICATION
  HANDOVER
}

enum RecordStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum NcrSeverity {
  CRITICAL
  MAJOR
  MINOR
  OBSERVATION
}

enum NcrStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  CLOSED
}

enum TripStatus {
  SCHEDULED
  LOADING
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

enum BillingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  INVOICED
  PARTIALLY_PAID
  PAID
  DISPUTED
}

enum ProductionStatus {
  PENDING
  PRODUCING
  READY
  CANCELLED
}

model Drawing {
  id               String            @id @default(cuid())
  projectId        String            @map("project_id")
  packageId        String?           @map("package_id")
  code             String            @map("code") // e.g. "Drawing F-101"
  title            String            // e.g. "แบบติดตั้งงานเสารั้ว (F)"
  revision         String            @default("01") // e.g. "03"
  status           RecordStatus      @default(APPROVED)
  approvedBy       String?           @map("approved_by") // e.g. "นายวิชาญ วิศวกรรม"
  approvedAt       DateTime?         @map("approved_at")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage      WorkPackage?      @relation(fields: [packageId], references: [id])
  bomItems         BomItem[]
  materialRequests MaterialRequest[]

  @@map("drawings")
}

model BomItem {
  id               String                @id @default(cuid())
  drawingId        String                @map("drawing_id")
  itemCode         String                @map("item_code") // e.g. "F-PANEL-01"
  name             String                // e.g. "แผ่นรั้ว F-PANEL-01"
  quantity         Decimal               @db.Decimal(14, 3) // ปริมาณตาม BOM
  additionalQty    Decimal               @default(0) @map("additional_qty") @db.Decimal(14, 3) // ปรับเพิ่ม
  unit             String                // แผ่น, ต้น, ชิ้น, ชุด
  spec             String?               // สเปก / ขนาด
  category         String?               // ประเภทวัสดุ
  requiredDate     DateTime?             @map("required_date")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  drawing          Drawing               @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  requestItems     MaterialRequestItem[]
  productionOrders ProductionOrder[]

  @@map("bom_items")
}

model ProductionOrder {
  id           String           @id @default(cuid())
  orderNo      String           @unique @map("order_no") // e.g. "PRD-260008", "PRD-260009"
  projectId    String           @map("project_id")
  requestId    String?          @map("request_id")
  bomItemId    String?          @map("bom_item_id")
  itemCode     String           @map("item_code") // e.g. "F-PANEL-01"
  itemName     String           @map("item_name") // e.g. "แผ่นรั้ว"
  quantity     Decimal          @db.Decimal(14, 3) // e.g. 20, 10
  unit         String           @default("แผ่น")
  spec         String?
  factory      String?          @default("ฝ่ายผลิต / โรงงานพรีคาสท์ PCC")
  readyDate    DateTime?        @map("ready_date")
  priority     String           @default("normal") // normal, urgent
  status       ProductionStatus @default(PENDING) // PENDING, PRODUCING, READY, CANCELLED
  latestUpdate String?          @map("latest_update") // e.g. "11 ก.ย. / ฝ่ายผลิต"
  history      Json             @default("[]")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  request      MaterialRequest? @relation(fields: [requestId], references: [id])
  bomItem      BomItem?         @relation(fields: [bomItemId], references: [id])

  @@map("production_orders")
}
